# BEL Trust Chain — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env — it's in .gitignore.

# Sepolia deployment — use a BURNER wallet with only testnet ETH
DEPLOYER_PRIVATE_KEY=
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# MultiSig signer addresses (3 EOAs for 2-of-3 governance)
SIGNER1_ADDRESS=
SIGNER2_ADDRESS=
SIGNER3_ADDRESS=

# BEL Treasury address (fixed owner for all AssetNFTs)
TREASURY_ADDRESS=

# Operator address (receives ASSET_MINTER_ROLE and STATUS_MANAGER_ROLE; defaults to deployer)
OPERATOR_ADDRESS=

# Optional: Signer private keys to automate 2-of-3 governance during live deployment
SIGNER1_PRIVATE_KEY=
SIGNER2_PRIVATE_KEY=
